<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.tmog.rapl-gate">
    <description>Open RAPL energy counters while Task Manager TMOG runs</description>
    <message>Task Manager TMOG needs read access to CPU energy counters</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tmog-rapl-gate/rapl-gate</annotate>
  </action>
</policyconfig>
